+  :root {
+    --canvas: #f7f7f8; --surface: #ffffff; --text: #18181b; --muted: #52525b; --border: #e4e4e7;
+    --accent: #4f46e5; --accent-ink: #ffffff; --bad: #b42318; --bad-bg: #fef3f2; --bad-border: #fecdca; --ok: #067647;
+  }
+  body { font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; background: var(--canvas); color: var(--text); font-size: 14px; line-height: 1.45; }
+  a { color: inherit; }
+  a:focus-visible, .btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
+  .nav { display: flex; align-items: center; gap: 32px; height: 56px; padding: 0 32px; background: var(--surface); border-bottom: 1px solid var(--border); }
+  .logo { font-weight: 800; font-size: 16px; color: var(--accent); text-decoration: none; }
+  .nav-links { display: flex; gap: 4px; flex: 1; }
+  .nav-links a { padding: 6px 10px; border-radius: 6px; color: var(--muted); text-decoration: none; }
+  .nav-links a.active { color: var(--text); font-weight: 600; background: #f0f0f2; }
+  .nav-links a.insights { margin-left: auto; color: var(--accent); }
+  .avatar { width: 28px; height: 28px; border-radius: 50%; background: #c7d2fe; }
+  main { max-width: 1216px; margin: 0 auto; padding: 20px 32px 32px; }
+  .page-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 14px; }
+  .page-head h1 { font-size: 20px; font-weight: 700; letter-spacing: -.01em; }
+  .page-head p { color: var(--muted); }
+  .alert { display: flex; align-items: center; gap: 24px; padding: 14px 18px; border: 1px solid var(--bad-border); border-left: 4px solid var(--bad); border-radius: 8px; background: var(--bad-bg); }
+  .alert-body { flex: 1; }
+  .alert h2 { font-size: 16px; font-weight: 700; color: var(--bad); }
+  .alert p { margin-top: 2px; color: #3f3f46; }
+  .alert .num { font-variant-numeric: tabular-nums; font-weight: 600; color: var(--text); }
+  .btn { display: inline-block; padding: 8px 14px; border-radius: 6px; font-weight: 600; text-decoration: none; white-space: nowrap; border: 1px solid var(--border); background: var(--surface); }
+  .btn.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
+  .summary { display: grid; grid-template-columns: repeat(4, 1fr); margin: 14px 0 20px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); }
+  .summary div { padding: 12px 18px; border-left: 1px solid var(--border); }
+  .summary div:first-child { border-left: 0; }
+  .summary dt { color: var(--muted); font-size: 13px; }
+  .summary dd { font-size: 20px; font-weight: 700; font-variant-numeric: tabular-nums; }
+  .summary dd small { font-size: 13px; font-weight: 500; color: var(--bad); }
+  .grid { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 20px; align-items: start; }
+  .panel { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; }
+  .panel h2 { font-size: 14px; font-weight: 700; padding: 12px 16px; border-bottom: 1px solid var(--border); }
+  table { width: 100%; border-collapse: collapse; }
+  th { text-align: left; font-size: 12px; font-weight: 600; color: var(--muted); padding: 8px 16px; border-bottom: 1px solid var(--border); }
+  td { padding: 10px 16px; border-bottom: 1px solid var(--border); font-variant-numeric: tabular-nums; }
+  tr:last-child td { border-bottom: 0; }
+  th.n, td.n { text-align: right; }
+  td a { font-weight: 600; text-decoration: none; }
+  td a:hover { text-decoration: underline; }
+  tr.degraded td { background: #fffbfa; }
+  tr.degraded td.err { color: var(--bad); font-weight: 700; }
+  .status { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; }
+  .status::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--ok); }
+  .status.ok { color: var(--ok); }
+  .status.bad { color: var(--bad); }
+  .status.bad::before { border-radius: 0; width: 0; height: 0; background: none; border-left: 5px solid transparent; border-right: 5px solid transparent; border-bottom: 9px solid var(--bad); }
+  .feed { list-style: none; }
+  .feed li { display: flex; justify-content: space-between; gap: 12px; padding: 10px 16px; border-bottom: 1px solid var(--border); }
+  .feed li:last-child { border-bottom: 0; }
+  .feed time { color: var(--muted); font-variant-numeric: tabular-nums; }
+  .feed a { font-weight: 600; }
+  footer { max-width: 1216px; margin: 0 auto; padding: 0 32px 32px; color: var(--muted); font-size: 13px; }
