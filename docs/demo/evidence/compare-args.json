{"before":{"html":"<!DOCTYPE html><html lang=\"en\"><head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Acme Cloud — Dashboard</title>\n<!-- Demo fixture: a fictional ops dashboard written for the web-stylebook README in a common\n     generated-UI style. Fixed data, clock 2026-11-05 14:31 UTC. Not a real product. -->\n<style>\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  body { font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; background: #f5f3ff; color: #1f2937; }\n  a { color: inherit; text-decoration: none; }\n  .nav { display: flex; align-items: center; justify-content: space-between; padding: 18px 40px; background: #fff; box-shadow: 0 1px 12px rgba(99, 102, 241, .12); }\n  .logo { font-weight: 800; font-size: 20px; background: linear-gradient(90deg, #6366f1, #a855f7); -webkit-background-clip: text; background-clip: text; color: transparent; }\n  .nav-links { display: flex; gap: 28px; font-size: 14px; color: #9ca3af; }\n  .nav-links a.active { color: #6366f1; font-weight: 600; }\n  .avatar { width: 36px; height: 36px; border-radius: 50%; background: linear-gradient(135deg, #f472b6, #8b5cf6); }\n  .hero { margin: 32px 40px; padding: 56px 40px; border-radius: 24px; text-align: center; color: #fff;\n          background: radial-gradient(circle at 20% 20%, #c084fc 0, transparent 40%), linear-gradient(135deg, #6366f1, #8b5cf6 55%, #ec4899); }\n  .hero h1 { font-size: 40px; font-weight: 800; letter-spacing: -.02em; }\n  .hero p { margin: 14px auto 28px; max-width: 560px; font-size: 18px; opacity: .85; }\n  .btn { display: inline-block; padding: 14px 28px; border-radius: 999px; background: #fff; color: #6d28d9; font-weight: 700; box-shadow: 0 10px 30px rgba(0,0,0,.15); }\n  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin: 0 40px; }\n  .card { background: #fff; border-radius: 20px; padding: 28px; box-shadow: 0 10px 30px rgba(99, 102, 241, .10); text-align: center; }\n  .card .icon { font-size: 32px; }\n  .card .label { margin-top: 10px; font-size: 13px; text-transform: uppercase; letter-spacing: .08em; color: #a1a1aa; }\n  .card .value { margin-top: 6px; font-size: 34px; font-weight: 800; background: linear-gradient(90deg, #6366f1, #a855f7); -webkit-background-clip: text; background-clip: text; color: transparent; }\n  .card .hint { margin-top: 6px; font-size: 13px; color: #c4b5fd; }\n  .section { margin: 40px; }\n  .section h2 { font-size: 22px; font-weight: 800; margin-bottom: 6px; }\n  .section .sub { color: #a1a1aa; font-size: 14px; margin-bottom: 18px; }\n  .features { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }\n  .feature { background: #fff; border-radius: 20px; padding: 28px; box-shadow: 0 10px 30px rgba(99, 102, 241, .08); }\n  .feature .icon { width: 48px; height: 48px; border-radius: 14px; display: grid; place-items: center; font-size: 22px; background: #ede9fe; }\n  .feature h3 { margin-top: 16px; font-size: 17px; }\n  .feature p { margin-top: 8px; font-size: 14px; color: #9ca3af; line-height: 1.6; }\n  table { width: 100%; border-collapse: separate; border-spacing: 0 10px; font-size: 14px; }\n  th { text-align: left; font-size: 12px; text-transform: uppercase; letter-spacing: .08em; color: #a1a1aa; padding: 0 20px; }\n  td { background: #fff; padding: 16px 20px; color: #9ca3af; }\n  td:first-child { border-radius: 14px 0 0 14px; color: #374151; font-weight: 600; }\n  td:last-child { border-radius: 0 14px 14px 0; }\n  .pill { display: inline-block; padding: 4px 12px; border-radius: 999px; font-size: 12px; font-weight: 600; background: #ede9fe; color: #7c3aed; }\n  .pill.warn { background: #fce7f3; color: #db2777; }\n  .feed li { list-style: none; background: #fff; border-radius: 14px; padding: 14px 20px; margin-bottom: 10px; color: #9ca3af; font-size: 14px; }\n  .feed li b { color: #4b5563; }\n  footer { text-align: center; padding: 32px; color: #c4b5fd; font-size: 13px; }\n</style>\n</head>\n<body>\n  <nav class=\"nav\">\n    <a class=\"logo\" href=\"/\">✦ Acme Cloud</a>\n    <div class=\"nav-links\">\n      <a class=\"active\" href=\"/dashboard\">Dashboard</a>\n      <a href=\"/services\">Services</a>\n      <a href=\"/deploys\">Deploys</a>\n      <a href=\"/incidents\">Incidents</a>\n      <a href=\"/settings\">Settings</a>\n    </div>\n    <div class=\"avatar\" aria-label=\"Jordan Lee\" role=\"img\"></div>\n  </nav>\n\n  <header class=\"hero\">\n    <h1>Welcome back, Jordan 👋</h1>\n    <p>Empower your team with seamless, AI-driven observability insights across your entire stack.</p>\n    <a class=\"btn\" href=\"/insights\" data-testid=\"insights-cta\">✨ Get AI insights →</a>\n  </header>\n\n  <section class=\"stats\">\n    <div class=\"card\"><div class=\"icon\">🧠</div><div class=\"label\">AI Health Score</div><div class=\"value\">94/100</div><div class=\"hint\">Looking great!</div></div>\n    <div class=\"card\"><div class=\"icon\">🚀</div><div class=\"label\">Uptime</div><div class=\"value\">99.98%</div><div class=\"hint\">Keep it up</div></div>\n    <div class=\"card\"><div class=\"icon\">⚡</div><div class=\"label\">Deploys</div><div class=\"value\">6</div><div class=\"hint\">Ship it!</div></div>\n    <div class=\"card\"><div class=\"icon\">🛡️</div><div class=\"label\">Incidents</div><div class=\"value\">1</div><div class=\"hint\">Stay vigilant</div></div>\n  </section>\n\n  <section class=\"section\">\n    <h2>Supercharge your workflow</h2>\n    <p class=\"sub\">Everything you need to monitor, deploy and scale — all in one place.</p>\n    <div class=\"features\">\n      <div class=\"feature\"><div class=\"icon\">📊</div><h3>Real-time analytics</h3><p>Unlock actionable insights with beautiful dashboards that update instantly.</p></div>\n      <div class=\"feature\"><div class=\"icon\">🤖</div><h3>Smart alerts</h3><p>Our AI learns your patterns so you can focus on what matters most.</p></div>\n      <div class=\"feature\"><div class=\"icon\">🔒</div><h3>Enterprise security</h3><p>Bank-grade protection keeps your data safe, secure and compliant.</p></div>\n    </div>\n  </section>\n\n  <section class=\"section\">\n    <h2>Your services</h2>\n    <p class=\"sub\">An overview of everything running in production.</p>\n    <table data-testid=\"services-table\">\n      <thead><tr><th>Service</th><th>Status</th><th>Error rate</th><th>p95 latency</th><th>Last deploy</th></tr></thead>\n      <tbody>\n        <tr><td><a href=\"/services/checkout-web\">checkout-web</a></td><td><span class=\"pill\">Healthy</span></td><td>0.1%</td><td>210 ms</td><td>#4809 · 11:40</td></tr>\n        <tr><td><a href=\"/services/auth-service\">auth-service</a></td><td><span class=\"pill\">Healthy</span></td><td>0.0%</td><td>95 ms</td><td>#4790 · yesterday</td></tr>\n        <tr><td><a href=\"/services/notifications\">notifications</a></td><td><span class=\"pill\">Healthy</span></td><td>0.2%</td><td>160 ms</td><td>#4811 · 13:20</td></tr>\n        <tr><td><a href=\"/services/search-indexer\">search-indexer</a></td><td><span class=\"pill\">Healthy</span></td><td>0.3%</td><td>1.2 s</td><td>#4805 · 09:15</td></tr>\n        <tr><td><a href=\"/services/payments-api\">payments-api</a></td><td><span class=\"pill warn\">Degraded</span></td><td>4.2%</td><td>840 ms</td><td>#4812 · 14:02</td></tr>\n      </tbody>\n    </table>\n  </section>\n\n  <section class=\"section\">\n    <h2>Recent activity</h2>\n    <p class=\"sub\">Stay in the loop with what your team is up to.</p>\n    <ul class=\"feed\">\n      <li><b>Priya</b> opened <a href=\"/incidents/INC-231\">INC-231</a> · 14:05</li>\n      <li><b>Sam</b> deployed <a href=\"/deploys/4812\">#4812</a> to payments-api · 14:02</li>\n      <li><b>Alex</b> deployed <a href=\"/deploys/4811\">#4811</a> to notifications · 13:20</li>\n      <li><b>Sam</b> deployed <a href=\"/deploys/4809\">#4809</a> to checkout-web · 11:40</li>\n    </ul>\n  </section>\n\n  <footer>Made with 💜 by the Acme Cloud team · <a href=\"/status\">Status</a> · <a href=\"/docs\">Docs</a></footer>\n\n\n</body></html>"},"after":{"html":"<!DOCTYPE html><html lang=\"en\"><head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Acme Cloud — Dashboard</title>\n<!-- Demo fixture: before.html after one pass of the web-stylebook-design skill. Same fictional\n     data and clock (2026-11-05 14:31 UTC). See docs/demo/README.md for how it was made. -->\n<style>\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  :root {\n    --canvas: #f7f7f8; --surface: #ffffff; --text: #18181b; --muted: #52525b; --border: #e4e4e7;\n    --accent: #4f46e5; --accent-ink: #ffffff; --bad: #b42318; --bad-bg: #fef3f2; --bad-border: #fecdca; --ok: #067647;\n  }\n  body { font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; background: var(--canvas); color: var(--text); font-size: 14px; line-height: 1.45; }\n  a { color: inherit; }\n  a:focus-visible, .btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }\n  .nav { display: flex; align-items: center; gap: 32px; height: 56px; padding: 0 32px; background: var(--surface); border-bottom: 1px solid var(--border); }\n  .logo { font-weight: 800; font-size: 16px; color: var(--accent); text-decoration: none; }\n  .nav-links { display: flex; gap: 4px; flex: 1; }\n  .nav-links a { padding: 6px 10px; border-radius: 6px; color: var(--muted); text-decoration: none; }\n  .nav-links a.active { color: var(--text); font-weight: 600; background: #f0f0f2; }\n  .nav-links a.insights { margin-left: auto; color: var(--accent); }\n  .avatar { width: 28px; height: 28px; border-radius: 50%; background: #c7d2fe; }\n  main { max-width: 1216px; margin: 0 auto; padding: 20px 32px 32px; }\n  .page-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 14px; }\n  .page-head h1 { font-size: 20px; font-weight: 700; letter-spacing: -.01em; }\n  .page-head p { color: var(--muted); }\n  .alert { display: flex; align-items: center; gap: 24px; padding: 14px 18px; border: 1px solid var(--bad-border); border-left: 4px solid var(--bad); border-radius: 8px; background: var(--bad-bg); }\n  .alert-body { flex: 1; }\n  .alert h2 { font-size: 16px; font-weight: 700; color: var(--bad); }\n  .alert p { margin-top: 2px; color: #3f3f46; }\n  .alert .num { font-variant-numeric: tabular-nums; font-weight: 600; color: var(--text); }\n  .btn { display: inline-block; padding: 8px 14px; border-radius: 6px; font-weight: 600; text-decoration: none; white-space: nowrap; border: 1px solid var(--border); background: var(--surface); }\n  .btn.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }\n  .summary { display: grid; grid-template-columns: repeat(4, 1fr); margin: 14px 0 20px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); }\n  .summary div { padding: 12px 18px; border-left: 1px solid var(--border); }\n  .summary div:first-child { border-left: 0; }\n  .summary dt { color: var(--muted); font-size: 13px; }\n  .summary dd { font-size: 20px; font-weight: 700; font-variant-numeric: tabular-nums; }\n  .summary dd small { font-size: 13px; font-weight: 500; color: var(--bad); }\n  .grid { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 20px; align-items: start; }\n  .panel { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; }\n  .panel h2 { font-size: 14px; font-weight: 700; padding: 12px 16px; border-bottom: 1px solid var(--border); }\n  table { width: 100%; border-collapse: collapse; }\n  th { text-align: left; font-size: 12px; font-weight: 600; color: var(--muted); padding: 8px 16px; border-bottom: 1px solid var(--border); }\n  td { padding: 10px 16px; border-bottom: 1px solid var(--border); font-variant-numeric: tabular-nums; }\n  tr:last-child td { border-bottom: 0; }\n  th.n, td.n { text-align: right; }\n  td a { font-weight: 600; text-decoration: none; }\n  td a:hover { text-decoration: underline; }\n  tr.degraded td { background: #fffbfa; }\n  tr.degraded td.err { color: var(--bad); font-weight: 700; }\n  .status { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; }\n  .status::before { content: \"\"; width: 8px; height: 8px; border-radius: 50%; background: var(--ok); }\n  .status.ok { color: var(--ok); }\n  .status.bad { color: var(--bad); }\n  .status.bad::before { border-radius: 0; width: 0; height: 0; background: none; border-left: 5px solid transparent; border-right: 5px solid transparent; border-bottom: 9px solid var(--bad); }\n  .feed { list-style: none; }\n  .feed li { display: flex; justify-content: space-between; gap: 12px; padding: 10px 16px; border-bottom: 1px solid var(--border); }\n  .feed li:last-child { border-bottom: 0; }\n  .feed time { color: var(--muted); font-variant-numeric: tabular-nums; }\n  .feed a { font-weight: 600; }\n  footer { max-width: 1216px; margin: 0 auto; padding: 0 32px 32px; color: var(--muted); font-size: 13px; }\n  footer a { margin-left: 12px; }\n</style>\n</head>\n<body>\n  <nav class=\"nav\" aria-label=\"Main\">\n    <a class=\"logo\" href=\"/\">✦ Acme Cloud</a>\n    <div class=\"nav-links\">\n      <a class=\"active\" href=\"/dashboard\" aria-current=\"page\">Dashboard</a>\n      <a href=\"/services\">Services</a>\n      <a href=\"/deploys\">Deploys</a>\n      <a href=\"/incidents\">Incidents</a>\n      <a href=\"/settings\">Settings</a>\n      <a class=\"insights\" href=\"/insights\" data-testid=\"insights-cta\">✨ Get AI insights</a>\n    </div>\n    <div class=\"avatar\" aria-label=\"Jordan Lee\" role=\"img\"></div>\n  </nav>\n\n  <main>\n    <header class=\"page-head\">\n      <h1>Production</h1>\n      <p>Welcome back, Jordan</p>\n    </header>\n\n    <section class=\"alert\" aria-labelledby=\"alert-title\">\n      <div class=\"alert-body\">\n        <h2 id=\"alert-title\">payments-api is degraded</h2>\n        <p>Error rate <span class=\"num\">4.2%</span> · p95 <span class=\"num\">840 ms</span> · last deploy <a href=\"/deploys/4812\">#4812</a> at 14:02 · <a href=\"/incidents/INC-231\">INC-231</a> opened by Priya at 14:05</p>\n      </div>\n      <a class=\"btn primary\" href=\"/incidents/INC-231\">Open INC-231</a>\n      <a class=\"btn\" href=\"/services/payments-api\">View payments-api</a>\n    </section>\n\n    <dl class=\"summary\">\n      <div><dt>Services</dt><dd>5 <small>1 degraded</small></dd></div>\n      <div><dt>Incidents</dt><dd>1 <small>open</small></dd></div>\n      <div><dt>Deploys</dt><dd>6</dd></div>\n      <div><dt>Uptime</dt><dd>99.98%</dd></div>\n    </dl>\n\n    <div class=\"grid\">\n      <section class=\"panel\" aria-labelledby=\"services-title\">\n        <h2 id=\"services-title\">Your services</h2>\n        <table data-testid=\"services-table\">\n          <thead><tr><th>Service</th><th>Status</th><th class=\"n\">Error rate</th><th class=\"n\">p95 latency</th><th>Last deploy</th></tr></thead>\n          <tbody>\n            <tr class=\"degraded\"><td><a href=\"/services/payments-api\">payments-api</a></td><td><span class=\"status bad\">Degraded</span></td><td class=\"n err\">4.2%</td><td class=\"n\">840 ms</td><td>#4812 · 14:02</td></tr>\n            <tr><td><a href=\"/services/notifications\">notifications</a></td><td><span class=\"status ok\">Healthy</span></td><td class=\"n\">0.2%</td><td class=\"n\">160 ms</td><td>#4811 · 13:20</td></tr>\n            <tr><td><a href=\"/services/checkout-web\">checkout-web</a></td><td><span class=\"status ok\">Healthy</span></td><td class=\"n\">0.1%</td><td class=\"n\">210 ms</td><td>#4809 · 11:40</td></tr>\n            <tr><td><a href=\"/services/search-indexer\">search-indexer</a></td><td><span class=\"status ok\">Healthy</span></td><td class=\"n\">0.3%</td><td class=\"n\">1.2 s</td><td>#4805 · 09:15</td></tr>\n            <tr><td><a href=\"/services/auth-service\">auth-service</a></td><td><span class=\"status ok\">Healthy</span></td><td class=\"n\">0.0%</td><td class=\"n\">95 ms</td><td>#4790 · yesterday</td></tr>\n          </tbody>\n        </table>\n      </section>\n\n      <section class=\"panel\" aria-labelledby=\"activity-title\">\n        <h2 id=\"activity-title\">Recent activity</h2>\n        <ul class=\"feed\">\n          <li><span><b>Priya</b> opened <a href=\"/incidents/INC-231\">INC-231</a></span><time>14:05</time></li>\n          <li><span><b>Sam</b> deployed <a href=\"/deploys/4812\">#4812</a> to payments-api</span><time>14:02</time></li>\n          <li><span><b>Alex</b> deployed <a href=\"/deploys/4811\">#4811</a> to notifications</span><time>13:20</time></li>\n          <li><span><b>Sam</b> deployed <a href=\"/deploys/4809\">#4809</a> to checkout-web</span><time>11:40</time></li>\n        </ul>\n      </section>\n    </div>\n  </main>\n\n  <footer>Acme Cloud <a href=\"/status\">Status</a> <a href=\"/docs\">Docs</a></footer>\n\n\n</body></html>"},"productType":"operational-saas","targetId":"dashboard-desktop","viewportWidth":1280,"locale":"en","acknowledged":[{"kind":"heading","key":"Real-time analytics","change":"dropped","reason":"Marketing feature card on a signed-in ops dashboard; it repeated product claims and pushed the services table below the first screen."},{"kind":"heading","key":"Smart alerts","change":"dropped","reason":"Marketing feature card on a signed-in ops dashboard; it repeated product claims and pushed the services table below the first screen."},{"kind":"heading","key":"Enterprise security","change":"dropped","reason":"Marketing feature card on a signed-in ops dashboard; it repeated product claims and pushed the services table below the first screen."},{"kind":"heading","key":"Welcome back, Jordan 👋","change":"reworded","reason":"The page heading now names the environment shown (Production); the greeting stays as a line beside it."},{"kind":"heading","key":"Supercharge your workflow","change":"reworded","reason":"Heading of the removed feature-card section; that slot now holds the degraded-service alert."},{"kind":"link","key":"/insights","change":"reworded","reason":"Same destination and test hook; only the arrow was dropped when the call to action moved into the navigation bar."},{"kind":"must-have","key":"recent-changes","change":"dropped","reason":"Not dropped: measured in Chrome at 1280x800 the Recent activity panel renders at y=303, on the first screen beside the services table. The static estimate follows document order."}]}