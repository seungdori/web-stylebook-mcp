// Regenerates tests/fixtures/website-visual-parity.v1.json from a website checkout's own resolver and CSS exporter,
// so the parity test compares the MCP's output with what the website itself computes for the same contract.
// Usage: npx tsx scripts/generate-website-parity-fixture.mts <website-checkout>
import { execFileSync } from 'node:child_process';
import { readFileSync, writeFileSync } from 'node:fs';
import { dirname, join, resolve } from 'node:path';
import { fileURLToPath, pathToFileURL } from 'node:url';

type Group = 'brutalist-grid' | 'editorial' | 'mono' | 'control';
interface CaseSpec { styleId: string; group: Group; authoredFonts: boolean }

// The styles the parity test covers. Each one gets a case per authored mode, plus an edited case in its default mode.
const STYLES: CaseSpec[] = [
  { styleId: 'brutalist-grid', group: 'brutalist-grid', authoredFonts: true },
  { styleId: 'editorial-silence', group: 'editorial', authoredFonts: true },
  { styleId: 'zen-minimalism', group: 'editorial', authoredFonts: true },
  { styleId: 'earth-atelier', group: 'editorial', authoredFonts: true },
  { styleId: 'paper-cut', group: 'editorial', authoredFonts: true },
  { styleId: 'mono-type', group: 'mono', authoredFonts: true },
  { styleId: 'fusion-grain-mono', group: 'mono', authoredFonts: true },
  { styleId: 'fusion-editorial-terminal', group: 'editorial', authoredFonts: true },
  { styleId: 'terminal-core', group: 'mono', authoredFonts: true },
  { styleId: 'cyberpunk-glitch', group: 'mono', authoredFonts: true },
  { styleId: 'fusion-cyber-console', group: 'mono', authoredFonts: true },
  { styleId: 'fusion-quiet-manifesto', group: 'mono', authoredFonts: true },
  { styleId: 'retro-pixel', group: 'mono', authoredFonts: true },
  { styleId: 'risograph-print', group: 'mono', authoredFonts: true },
  { styleId: 'quiet-utility', group: 'control', authoredFonts: false },
];
const OVERRIDES = { colors: { text: '#101010' }, typography: { body: { lineHeight: 1.8, letterSpacingEm: 0 } }, density: 'compact' } as const;

const website = resolve(process.argv[2] ?? join(dirname(fileURLToPath(import.meta.url)), '..', '..', 'showcase'));
const revision = execFileSync('git', ['-C', website, 'rev-parse', 'HEAD'], { encoding: 'utf8' }).trim();
const { resolveContract } = await import(pathToFileURL(join(website, 'src/visual/resolve.ts')).href);
const { visualContractToCss } = await import(pathToFileURL(join(website, 'src/visual/export.ts')).href);
const library = JSON.parse(readFileSync(join(website, 'packages/mcp/generated/visual-contracts.v1.json'), 'utf8'));

const cases = STYLES.flatMap((spec) => {
  const contract = library.contracts[spec.styleId];
  if (!contract) throw new Error(`${spec.styleId} is not in the website's visual library`);
  const modes = (['light', 'dark'] as const).filter((mode) => contract.modes[mode]);
  const run = (mode: 'light' | 'dark', overrides?: typeof OVERRIDES) => {
    const resolved = resolveContract(contract, { mode, contentLocale: 'en', ...(overrides ? { overrides } : {}) });
    return {
      ...spec, mode, locale: 'en' as const, defaultMode: contract.defaultMode,
      ...(overrides ? { overrides } : {}), resolved, css: visualContractToCss(resolved),
    };
  };
  return [...modes.map((mode) => run(mode)), run(contract.defaultMode, OVERRIDES)];
});

const out = join(dirname(fileURLToPath(import.meta.url)), '..', 'tests', 'fixtures', 'website-visual-parity.v1.json');
writeFileSync(out, `${JSON.stringify({
  schema: 'webstylebook.website-parity-fixture.v1',
  source: 'https://github.com/seungdori/web-stylebook',
  sourceRevision: revision,
  note: 'Generated by scripts/generate-website-parity-fixture.mts from the website resolver and CSS exporter at sourceRevision. Tests must read this file only and must not fetch the website.',
  cases,
})}\n`);
process.stderr.write(`[parity] wrote ${cases.length} cases from ${revision}\n`);
